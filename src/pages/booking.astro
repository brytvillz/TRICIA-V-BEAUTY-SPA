---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
---
<Base
  title="Book an Appointment in Nnewi | TRICIA-V"
  description="Book an appointment at TRICIA-V Unisex Salon and Spa in Nnewi. Choose your service, a day and a time, then send your request on WhatsApp. We confirm your exact time."
  path="/booking"
>
  <section class="booking">
    <div class="booking-inner">
      <p class="eyebrow">Book</p>
      <h1 class="page-h1 booking-h1">Book your appointment</h1>
      <p class="tagline">Choose your service and a day that suits you. We'll confirm your time on WhatsApp.</p>

      <BookingForm />
    </div>
  </section>
</Base>
