---
import { MAP_EMBED } from '../lib/site';
---
<div class="map" data-reveal>
  <iframe
    src={MAP_EMBED}
    width="100%"
    height="320"
    style="border:0"
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    title="Map showing TRICIA-V Unisex Salon and Spa on Google Maps"></iframe>
</div>
