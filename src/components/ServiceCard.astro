---
import { bookingHref } from '../data/booking';

/* A card on a service page: one treatment with a short description and a booking link. */
interface Props {
  title: string;
  text: string;
  /** plain-text name used in the aria-label and in the WhatsApp message */
  label: string;
  /** false for information cards (e.g. "How it works") that are not a bookable service */
  book?: boolean;
}
const { title, text, label, book = true } = Astro.props;
---
<article class="offer">
  <h3>{title}</h3>
  <p>{text}</p>
  {book && <a class="dm" href={bookingHref(label)} aria-label={`Book ${label}`}>Book</a>}
</article>
