---
import Picture from './Picture.astro';
import { bookingHref } from '../data/booking';

interface Props {
  index: number;
  total: number;
  slug: string;
  title: string;
  tagline: string;
  image: string;
  alt: string;
  pills: string[];
}
const { index, total, slug, title, tagline, image, alt, pills } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<article class="gcard" style={`--i:${index}`} aria-labelledby={`g-${slug}`}>
  <div class="g-photo">
    <Picture name={image} alt={alt} sizes="(max-width: 899px) 90vw, 550px" eager={index < 2} low={index < 2} />
  </div>
  <div class="g-body">
    <p class="g-count">{pad(index + 1)} / {pad(total)}</p>
    <h3 id={`g-${slug}`}>{title}</h3>
    <p class="g-desc">{tagline}</p>
    <div class="pills">
      {pills.map((p) => <span class="pill">{p}</span>)}
    </div>
    <div class="g-actions">
      <a class="btn btn-line" href={`/${slug}`} aria-label={`Explore ${title}`}>Explore</a>
      <a class="btn btn-fill" href={bookingHref(slug)} aria-label={`Book ${title}`}>Book</a>
    </div>
  </div>
  <div class="g-dim" aria-hidden="true"></div>
</article>
