---
/* Full-screen mobile menu. It is rendered as a direct child of <body>, NOT inside the header:
   the header gets backdrop-filter when scrolled, and that makes any position:fixed child
   size itself to the header (WebKit) instead of the screen. */
import ThemeToggle from './ThemeToggle.astro';
import { getCollection } from 'astro:content';
import { wa } from '../lib/site';
interface Props { path?: string }
const { path = '/' } = Astro.props;
const pages = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<div class="menu-panel" id="menuPanel" role="dialog" aria-modal="true" aria-label="Menu" inert>
  <div class="menu-top">
    <a href="/" class="brand" aria-label="TRICIA-V, home">
      <picture><source srcset="/images/logo-mark-192.webp" type="image/webp" /><img class="brand-mark" src="/images/logo-mark-192.png" alt="" width="192" height="192" decoding="async" /></picture>
      <span class="logo">TRICIA-V</span>
    </a>
    <div class="nav-actions">
      <ThemeToggle />
      <button type="button" class="menu-close" id="menuClose" aria-label="Close menu">
        <svg class="ic" aria-hidden="true"><use href="#i-close" /></svg>
      </button>
    </div>
  </div>
  <nav class="menu-list" aria-label="Mobile">
    <ul>
      <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
      <li class="menu-group">
        <p class="menu-label" id="menuServicesLabel">Services</p>
        <ul aria-labelledby="menuServicesLabel">
          {pages.map((p) => <li><a href={'/' + p.data.slug} aria-current={path === '/' + p.data.slug ? 'page' : undefined}>{p.data.navLabel}</a></li>)}
        </ul>
      </li>
      <li><a href="/#gallery">Gallery</a></li>
      <li><a href="/#about">About</a></li>
    </ul>
    <a href={wa()} class="btn btn-fill" target="_blank" rel="noopener">Book Now</a>
  </nav>
</div>
